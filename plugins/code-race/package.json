{
	"name": "@delendai/code-race",
	"version": "0.1.0",
	"type": "module",
	"description": "DelendAI sub-4s breach auto-racer plugin (converts delend-code-race): pattern-borrow + hedged code-race on budget breach.",
	"license": "BSD-3-Clause",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		},
		"./lib/race": {
			"types": "./src/lib/race.ts",
			"import": "./src/lib/race.ts"
		},
		"./lib/scriptRunner": {
			"types": "./src/lib/scriptRunner.ts",
			"import": "./src/lib/scriptRunner.ts"
		}
	},
	"bin": {
		"delend-code-race-line": "./bin/race-line.ts"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"dependencies": {
		"zod": "^4.4.3",
		"@delendai/consent": "workspace:*",
		"@delendai/core": "workspace:*"
	}
}
