{
	"name": "@delendai/model-race",
	"version": "0.1.0",
	"type": "module",
	"description": "DelendAI modular profile runner plugin (converts delend-model-race): race any model over complexity profiles, adaptive backoff, live model discovery.",
	"license": "BSD-3-Clause",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		}
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"dependencies": {
		"zod": "^4.4.3",
		"@delendai/consent": "workspace:*"
	}
}
