{
	"name": "@delendai/work-refs",
	"version": "0.1.0",
	"type": "module",
	"description": "DelendAI shared-checkout-merge work-ref checkpoint, dirty-tree snapshot, and guarded stash-optimize plugin (converts delend-quick, delend-working-dirty, delend-stash-optimize).",
	"license": "BSD-3-Clause",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		}
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"dependencies": {
		"zod": "^4.4.3",
		"@delendai/consent": "workspace:*"
	}
}
